        ],
        "outputs": [
          {
            "id": "out1",
            "name": "out1",
            "kind": "output"
          }
        ]
      },
      "parameters": {
        "input_count": 1,
        "output_count": 1,
        "includes": [],
        "global_declarations": "#include <Wire.h>\n\n#ifndef MT6701_REG_ANGLE\n#define MT6701_REG_ANGLE 0x03\n#endif\n",
        "init_code": "Wire.begin();\n",
        "step_code": "// このブロック専用の保持変数\nstatic bool initialized = false;\nstatic double prev_deg = 0.0;\nstatic double total_deg = 0.0;\n\n// 入力ポート0からI2Cアドレスを取得（7bit範囲にマスク）\nuint8_t addr = ((uint8_t)inputs[0]) & 0x7F;\n\nif (addr == 0) {\n    outputs[0] = 0.0f;\n    return;\n}\n\n// 受信バッファにゴミが残っていればクリア\nwhile (Wire.available() > 0) {\n    Wire.read();\n}\n\n// MT6701から2バイト(0x03, 0x04)読み出し（STOPコンディションを確実に発行）\nWire.beginTransmission(addr);\nWire.write(MT6701_REG_ANGLE);\nuint8_t err = Wire.endTransmission(true);\n\nif (err == 0) {\n    uint8_t count = Wire.requestFrom(addr, (uint8_t)2);\n    if (count >= 2 && Wire.available() >= 2) {\n        uint8_t highByte = Wire.read();\n        uint8_t lowByte  = Wire.read();\n\n        // 14ビット合成・角度変換 [0 ~ 360 deg]\n        uint16_t raw_angle = ((uint16_t)highByte << 6) | (lowByte >> 2);\n        double current_deg = (double)raw_angle * 360.0 / 16384.0;\n\n        // 360度またぎ補正・相対角度の積算\n        if (!initialized) {\n            prev_deg = current_deg;\n            total_deg = 0.0;\n            initialized = true;\n        } else {\n            double diff = current_deg - prev_deg;\n\n            if (diff < -180.0) {\n                diff += 360.0;\n            } else if (diff > 180.0) {\n                diff -= 360.0;\n            }\n\n            total_deg += diff;\n            prev_deg = current_deg;\n        }\n    }\n}\n\n// 出力ポートへ代入\noutputs[0] = (float)total_deg;\n",
        "direct_feedthrough": true
      },
